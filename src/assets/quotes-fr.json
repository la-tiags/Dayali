[
  {
    "text": "Il faut manger pour vivre, et non pas vivre pour manger.",
    "author": "Molière",
    "source": "L'Avare",
    "sourceDetail": "Acte III, scène V",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Molière",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1673
  },
  {
    "text": "On ne meurt qu'une fois, et c'est pour si longtemps !",
    "author": "Molière",
    "source": "Le Dépit amoureux",
    "sourceDetail": "Acte V, scène IV",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Molière",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1673
  },
  {
    "text": "Tout bourgeois veut bâtir comme les grands seigneurs.",
    "author": "Jean de La Fontaine",
    "source": "La Grenouille qui se veut faire aussi grosse que le bœuf",
    "sourceDetail": "Fables, livre I, fable III",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Jean_de_La_Fontaine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1695
  },
  {
    "text": "Patience et longueur de temps font plus que force ni que rage.",
    "author": "Jean de La Fontaine",
    "source": "Le Lion et le Rat",
    "sourceDetail": "Fables, livre II, fable XI",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Jean_de_La_Fontaine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1695
  },
  {
    "text": "Le cœur a ses raisons que la raison ne connaît point.",
    "author": "Blaise Pascal",
    "source": "Pensées",
    "sourceDetail": "Fragment 397 (éd. Michel Le Guern)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Blaise_Pascal",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1662
  },
  {
    "text": "L'homme n'est qu'un roseau, le plus faible de la nature ; mais c'est un roseau pensant.",
    "author": "Blaise Pascal",
    "source": "Pensées",
    "sourceDetail": "Édition de Port-Royal (1670), p. 179",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Blaise_Pascal",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1662
  },
  {
    "text": "Le silence éternel de ces espaces infinis m'effraie.",
    "author": "Blaise Pascal",
    "source": "Pensées",
    "sourceDetail": "Édition Gallimard/Le Livre de Poche (1969), p. 58-60",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Blaise_Pascal",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1662
  },
  {
    "text": "Je pense, donc je suis.",
    "author": "René Descartes",
    "source": "Discours de la méthode",
    "sourceDetail": "Partie IV (1637)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/René_Descartes",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1650
  },
  {
    "text": "Le bon sens est la chose du monde la mieux partagée.",
    "author": "René Descartes",
    "source": "Discours de la méthode",
    "sourceDetail": "Partie I (1637)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/René_Descartes",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1650
  },
  {
    "text": "Le mieux est l'ennemi du bien.",
    "author": "Voltaire",
    "source": "La Bégueule",
    "sourceDetail": "Contes en vers, « La Bégueule » (1772), vers 1-2 ; Voltaire y rend en français le proverbe italien « Il meglio è nemico del bene », cité dans le Dictionnaire philosophique, article « Art dramatique ».",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Voltaire",
    "translation": {
      "from": "italien (proverbe)",
      "translator": "Voltaire",
      "edition": "La Bégueule, Contes en vers (1772)",
      "rights": "domaine public — Voltaire est mort en 1778"
    },
    "translationRights": "traduction/adaptation française de Voltaire — domaine public",
    "authorDeathYear": 1778
  },
  {
    "text": "Il faut cultiver notre jardin.",
    "author": "Voltaire",
    "source": "Candide",
    "sourceDetail": "Candide, ou l'Optimisme, chapitre XXX (1759)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Voltaire",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1778
  },
  {
    "text": "Le fanatisme est à la superstition ce que le transport est à la fièvre.",
    "author": "Voltaire",
    "source": "Dictionnaire philosophique",
    "sourceDetail": "Article « Fanatisme » (1764)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Voltaire",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1778
  },
  {
    "text": "L'homme est né libre, et partout il est dans les fers.",
    "author": "Jean-Jacques Rousseau",
    "source": "Du contrat social",
    "sourceDetail": "Livre I, chapitre I (1762)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Jean-Jacques_Rousseau",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1778
  },
  {
    "text": "Il faut que, par la disposition des choses, le pouvoir arrête le pouvoir.",
    "author": "Montesquieu",
    "source": "De l'esprit des lois",
    "sourceDetail": "Livre XI, chapitre IV (1748)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Montesquieu",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1755
  },
  {
    "text": "La liberté est le droit de faire tout ce que les lois permettent.",
    "author": "Montesquieu",
    "source": "De l'esprit des lois",
    "sourceDetail": "Livre XI, chapitre III (1748)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Montesquieu",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1755
  },
  {
    "text": "Sans la liberté de blâmer, il n'est point d'éloge flatteur.",
    "author": "Pierre-Augustin Caron de Beaumarchais",
    "source": "Le Mariage de Figaro",
    "sourceDetail": "Acte V, scène 3",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Pierre-Augustin_Caron_de_Beaumarchais",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1799
  },
  {
    "text": "Je me presse de rire de tout, de peur d'être obligé d'en pleurer.",
    "author": "Pierre-Augustin Caron de Beaumarchais",
    "source": "Le Barbier de Séville",
    "sourceDetail": "Acte I, scène 2",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Pierre-Augustin_Caron_de_Beaumarchais",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1799
  },
  {
    "text": "Boire sans soif et faire l'amour en tout temps, madame, il n'y a que ça qui nous distingue des autres bêtes.",
    "author": "Pierre-Augustin Caron de Beaumarchais",
    "source": "Le Mariage de Figaro",
    "sourceDetail": "Acte II, scène 21",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Pierre-Augustin_Caron_de_Beaumarchais",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1799
  },
  {
    "text": "L'amour est une fleur délicieuse, mais il faut avoir le courage d'aller la cueillir sur les bords d'un précipice.",
    "author": "Stendhal",
    "source": "De l'amour",
    "sourceDetail": "Chapitre XLI (1822)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Stendhal",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1842
  },
  {
    "text": "La gloire est le soleil des morts.",
    "author": "Honoré de Balzac",
    "source": "La Recherche de l'Absolu",
    "sourceDetail": "La Recherche de l'Absolu (1834)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Honoré_de_Balzac",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1850
  },
  {
    "text": "On n'est pas sérieux, quand on a dix-sept ans.",
    "author": "Arthur Rimbaud",
    "source": "Roman",
    "sourceDetail": "Cahier de Douai, « Roman » (1870), vers 29-30",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Arthur_Rimbaud",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1891
  },
  {
    "text": "Il faut être absolument moderne.",
    "author": "Arthur Rimbaud",
    "source": "Une saison en enfer",
    "sourceDetail": "« Adieu » (1873)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Arthur_Rimbaud",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1891
  },
  {
    "text": "Je est un autre.",
    "author": "Arthur Rimbaud",
    "source": "Lettre à Paul Demeny",
    "sourceDetail": "Lettre du 15 mai 1871 ; la formule figure aussi dans la lettre à Georges Izambard du 13 mai 1871",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Arthur_Rimbaud",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1891
  },
  {
    "text": "Le ciel est, par-dessus le toit, si bleu, si calme !",
    "author": "Paul Verlaine",
    "source": "Sagesse",
    "sourceDetail": "« Le ciel est par-dessus le toit » (1880)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Paul_Verlaine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1896
  },
  {
    "text": "La vérité est en marche et rien ne l'arrêtera.",
    "author": "Émile Zola",
    "source": "J'accuse",
    "sourceDetail": "« J'accuse… ! », L'Aurore, 13 janvier 1898",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Émile_Zola",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1902
  },
  {
    "text": "Une œuvre d'art est un coin de la création vu à travers un tempérament.",
    "author": "Émile Zola",
    "source": "Mon Salon",
    "sourceDetail": "Mon Salon (1866), « Les réalistes du salon » ; texte repris dans Mes haines",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Émile_Zola",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1902
  },
  {
    "text": "Un seul être vous manque, et tout est dépeuplé.",
    "author": "Alphonse de Lamartine",
    "source": "L'Isolement",
    "sourceDetail": "Méditations poétiques, « L'Isolement » (1820)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Alphonse_de_Lamartine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1869
  },
  {
    "text": "Ô temps, suspends ton vol ! et vous, heures propices, suspendez votre cours !",
    "author": "Alphonse de Lamartine",
    "source": "Le Lac",
    "sourceDetail": "Méditations poétiques, « Le Lac » (1820)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Alphonse_de_Lamartine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1869
  },
  {
    "text": "Les utopies ne sont souvent que des vérités prématurées.",
    "author": "Alphonse de Lamartine",
    "source": "Histoire des Girondins",
    "sourceDetail": "Histoire des Girondins, livre XXIII (1847)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Alphonse_de_Lamartine",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1869
  },
  {
    "text": "Les plus désespérés sont les chants les plus beaux.",
    "author": "Alfred de Musset",
    "source": "La Nuit de mai",
    "sourceDetail": "La Nuit de mai (1835)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Alfred_de_Musset",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1857
  },
  {
    "text": "On ne badine pas avec l'amour.",
    "author": "Alfred de Musset",
    "source": "On ne badine pas avec l'amour",
    "sourceDetail": "Titre de la comédie (1834)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Alfred_de_Musset",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1857
  },
  {
    "text": "Ceux qui vivent, ce sont ceux qui luttent.",
    "author": "Victor Hugo",
    "source": "Les Châtiments",
    "sourceDetail": "Les Châtiments, livre IV, poème IX (1853)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Victor_Hugo",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1885
  },
  {
    "text": "Le vent se lève !... Il faut tenter de vivre !",
    "author": "Paul Valéry",
    "source": "Le Cimetière marin",
    "sourceDetail": "Le Cimetière marin (1920), vers 24",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Paul_Valéry",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1945
  },
  {
    "text": "La mer, la mer, toujours recommencée !",
    "author": "Paul Valéry",
    "source": "Le Cimetière marin",
    "sourceDetail": "Le Cimetière marin (1920), vers 4",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Paul_Valéry",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1945
  },
  {
    "text": "Sous le pont Mirabeau coule la Seine.",
    "author": "Guillaume Apollinaire",
    "source": "Le Pont Mirabeau",
    "sourceDetail": "Alcools, « Le Pont Mirabeau » (1913)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Guillaume_Apollinaire",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1918
  },
  {
    "text": "La joie venait toujours après la peine.",
    "author": "Guillaume Apollinaire",
    "source": "Le Pont Mirabeau",
    "sourceDetail": "Alcools, « Le Pont Mirabeau » (1913)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Guillaume_Apollinaire",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1918
  },
  {
    "text": "Il est grand temps de rallumer les étoiles.",
    "author": "Guillaume Apollinaire",
    "source": "Les Mamelles de Tirésias",
    "sourceDetail": "Les Mamelles de Tirésias (1917)",
    "sourceUrl": "https://fr.wikiquote.org/wiki/Guillaume_Apollinaire",
    "translation": null,
    "translationRights": "original français — domaine public",
    "authorDeathYear": 1918
  }
]
